<Window x:Class="EverNote2OneNote.App.TextReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneNote connection check"
        Width="900" Height="600" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OpenFolderButton" Content="Open Report Folder" Padding="16,5" Margin="0,0,8,0" Visibility="Collapsed" Click="OpenFolder_Click" />
            <Button Content="Copy to Clipboard" Padding="16,5" Click="Copy_Click" />
            <Button x:Name="ConfirmButton" Padding="16,5" Margin="8,0,0,0" FontWeight="SemiBold" Visibility="Collapsed" Click="Confirm_Click" />
            <Button x:Name="CloseButton" Content="Close" Padding="16,5" Margin="8,0,0,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </StackPanel>
        <TextBox x:Name="ReportBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="6" />
    </DockPanel>
</Window>
