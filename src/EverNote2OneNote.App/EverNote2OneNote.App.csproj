<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the project compile (not run) on Linux/macOS so the whole solution builds everywhere. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>EverNote2OneNote</AssemblyName>
    <PackageId>EverNote2OneNote.App</PackageId>
    <RootNamespace>EverNote2OneNote.App</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>EverNote2OneNote</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64  =>  one self-contained EverNote2OneNote.exe, no .NET install needed. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EverNote2OneNote\EverNote2OneNote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft sign-in (delegated access to the user's OneNote). Tokens are kept in memory only. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
  </ItemGroup>

</Project>
