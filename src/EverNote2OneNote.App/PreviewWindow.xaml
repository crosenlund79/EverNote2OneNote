<Window x:Class="EverNote2OneNote.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attachment preview"
        Width="820" Height="660" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="13">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="File name:" Foreground="#555" Margin="0,0,10,2" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Text="Notebook:" Foreground="#555" Margin="0,0,10,2" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Notebook}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2" Text="Note title:" Foreground="#555" Margin="0,0,10,2" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NoteTitle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="3" Text="Size:" Foreground="#555" Margin="0,0,10,2" />
            <TextBlock Grid.Row="3" Grid.Column="1">
                <Run Text="{Binding Size, Mode=OneWay}" /><Run Text="  (" /><Run Text="{Binding Type, Mode=OneWay}" /><Run Text=")" />
            </TextBlock>
            <TextBlock Grid.Row="4" Text="Reference:" Foreground="#555" Margin="0,0,10,2" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Reference}" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Padding="20,5" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </StackPanel>

        <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="#F5F5F5">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="8"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="MessageText" Text="Loading image..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="24" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
