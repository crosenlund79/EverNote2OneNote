<Window x:Class="EverNote2OneNote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EverNote2OneNote - Inspect Evernote export"
        Width="1050" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <DockPanel Margin="14">

        <!-- 1. Choose folder -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Evernote export folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FolderBox" Grid.Column="1" IsReadOnly="True" Padding="4" VerticalContentAlignment="Center" />
            <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Padding="14,4" Click="Browse_Click" />
        </Grid>

        <!-- 2. Actions -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="InspectButton" Content="Inspect Archive" Padding="18,6" FontWeight="SemiBold" IsEnabled="False" Click="Inspect_Click" />
            <Button x:Name="OpenReportButton" Content="Open Report Folder" Padding="18,6" Margin="8,0,0,0" IsEnabled="False" Click="OpenReport_Click" />
        </StackPanel>

        <!-- Progress -->
        <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
            <ProgressBar x:Name="ProgressBar" Height="12" Minimum="0" Maximum="1" />
            <TextBlock x:Name="StatusText" Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="Click Browse... and choose the folder that contains your Evernote .enex files." />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#666" TextWrapping="Wrap"
                   Text="Read-only: your .enex files are never changed and nothing is uploaded. The detailed report contains note titles and text - keep it private." />

        <!-- Result -->
        <Border x:Name="ResultBanner" DockPanel.Dock="Top" Margin="0,12,0,0" Padding="12,8" CornerRadius="4" Visibility="Collapsed">
            <TextBlock x:Name="ResultText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <ItemsControl x:Name="FiguresList" DockPanel.Dock="Top" Margin="0,10,0,0" Visibility="Collapsed" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="118" Margin="0,0,8,8" Padding="9,6" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Label}" Foreground="#555" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl x:Name="ResultTabs" Margin="0,4,0,0" Visibility="Collapsed">
            <TabItem x:Name="FindingsTab" Header="Warnings and errors">
                <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E5E5">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                    <Setter Property="Background" Value="#FDE7E9" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter Property="Background" Value="#FFF4CE" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="75" />
                        <DataGridTextColumn Header="Finding" Binding="{Binding Code}" Width="170">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip" Value="{Binding Meaning}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="File" Binding="{Binding File}" Width="160" />
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="45" />
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="170" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="NotebooksTab" Header="Notebooks">
                <DataGrid x:Name="NotebooksGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E5E5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Notebook" Binding="{Binding Notebook}" Width="*" />
                        <DataGridTextColumn Header="File" Binding="{Binding File}" Width="*" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="60" />
                        <DataGridTextColumn Header="Text extracted" Binding="{Binding TextExtracted}" Width="95" />
                        <DataGridTextColumn Header="Text recovered" Binding="{Binding TextRecovered}" Width="100" />
                        <DataGridTextColumn Header="Not recovered" Binding="{Binding TextNotRecovered}" Width="95" />
                        <DataGridTextColumn Header="Attachments" Binding="{Binding Attachments}" Width="85" />
                        <DataGridTextColumn Header="Size" Binding="{Binding AttachmentSize}" Width="75" />
                        <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="55" />
                        <DataGridTextColumn Header="Warnings" Binding="{Binding Warnings}" Width="65" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Summary (safe to share)">
                <TextBox x:Name="SummaryBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" BorderThickness="0" Padding="6"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
