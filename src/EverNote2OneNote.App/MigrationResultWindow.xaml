<Window x:Class="EverNote2OneNote.App.MigrationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Migration result"
        Width="920" Height="640" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
    <DockPanel Margin="12">
        <Border x:Name="Banner" DockPanel.Dock="Top" Padding="12,8" CornerRadius="4">
            <TextBlock x:Name="BannerText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>
        <TextBlock x:Name="DetailsText" DockPanel.Dock="Top" Margin="0,10,0,0" TextWrapping="Wrap" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OpenOneNoteButton" Content="Open in OneNote" Padding="16,5" Click="OpenOneNote_Click" />
            <Button x:Name="OpenWebButton" Content="Open in browser" Padding="16,5" Margin="8,0,0,0" Click="OpenWeb_Click" />
            <Button Content="Close" Padding="16,5" Margin="8,0,0,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </StackPanel>

        <TabControl Margin="0,10,0,0">
            <TabItem x:Name="TextTab" Header="Text differences">
                <DockPanel>
                    <TextBlock x:Name="TextSummary" DockPanel.Dock="Top" Margin="4,4,4,6" TextWrapping="Wrap" />
                    <DataGrid x:Name="DifferencesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E5E5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" />
                            <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Where (original text)" Binding="{Binding Context}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="AttachmentsTab" Header="Attachments">
                <DataGrid x:Name="AttachmentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E5E5">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                    <Setter Property="Background" Value="#FDE7E9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="75" />
                        <DataGridTextColumn Header="Placement" Binding="{Binding Placement}" Width="100" />
                        <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="NoticesTab" Header="Notes">
                <ListBox x:Name="NoticesList" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,4" MaxWidth="820" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
