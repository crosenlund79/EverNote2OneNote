<Window x:Class="EverNote2OneNote.App.ClientIdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to OneNote - one-time setup"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap">
            To connect to OneNote, Microsoft requires an app registration that you create once in your own Microsoft
            Entra tenant (free). The steps are in README.txt next to EverNote2OneNote.exe:
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="12,8,0,0" Foreground="#333">
            1. entra.microsoft.com: Entra ID &gt; App registrations &gt; New registration<LineBreak />
            2. Supported account types: Personal accounts only (or Any Entra ID tenant + Personal Microsoft accounts)<LineBreak />
            3. Redirect URI: Public client/native (mobile &amp; desktop) - http://localhost<LineBreak />
            4. Copy the Application (client) ID and paste it below.
        </TextBlock>
        <TextBlock Text="Application (client) ID:" Margin="0,14,0,4" />
        <TextBox x:Name="ClientIdBox" Padding="4" FontFamily="Consolas" />
        <TextBlock x:Name="ErrorText" Foreground="#A4262C" Margin="0,4,0,0" Visibility="Collapsed"
                   Text="That is not a valid ID. It looks like 00000000-0000-0000-0000-000000000000." />
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#555"
                   Text="The ID is not a secret. It is saved on this computer only. Your password is entered on Microsoft's sign-in page, never in this app." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save and sign in" Padding="16,5" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" Padding="16,5" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
